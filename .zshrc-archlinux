# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# User configuration

export EDITOR='vim'

move-commit() {
    # git stash
    echo "RUN: git stash"
    git stash

    the_day_before=1
    time="23:00:00"
    if [[ $# -eq 2 ]]; then
        the_day_before=$1
        time=$2
    elif [[ $# -eq 1 ]]
    then
        the_day_before=$1
    fi

    is_git_repository=$(git rev-parse --is-inside-work-tree)
    if [[ ! $is_git_repository ]]
    then
        echo "This directory is not a git repository."
        exit 0
    fi

    target_date_command="date --date='-${the_day_before} day'"
    month_and_date=$(eval "${target_date_command} '+%b %d'")
    year=$(eval "${target_date_command} '+%Y'")

    # git rebase
    echo "RUN: git rebase"
    git rebase HEAD^ -i

    # Edit git committer date
    echo
    echo
    echo "RUN: Edit git committer date"
    modified_time_string="${month_and_date} ${time} ${year} +0900"
    echo
    echo "modified_time_string: ${modified_time_string}"
    echo
    modified_git_committer_date="GIT_COMMITTER_DATE=\"${modified_time_string}\" git commit --amend --no-edit --date \"${modified_time_string}\""
    eval "$modified_git_committer_date"

    # git rebase --continue
    echo
    echo
    echo "RUN: git rebase --continue"
    git rebase --continue

    # git stash pop
    echo
    echo
    echo "RUN: git stash pop"
    git stash pop
}

# jenv
export PATH="$HOME/.jenv/bin:$PATH"
if command -v jenv 1>/dev/null 2>&1; then
    eval "$(jenv init -)"
fi

source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

source ~/git-folders/not-mine/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh


