// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "title_bar": {
    "show_branch_status_icon": true
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "fallback_branch_name": "master",
    "dock": "left",
    "tree_view": true
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.3-codex",
      "enable_thinking": true
    },
    "commit_message_model": {
      "provider": "openai",
      "model": "gpt-5.3-codex"
    }
  },
  "disable_ai": false,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  },
  "languages": {
    "Kotlin": {
      "language_servers": ["kotlin-lsp"]
    },
    "Python": {
      "code_actions_on_format": {
        // Organize imports
        "source.organizeImports.ruff": true,
        // Fix all auto-fixable lint violations
        "source.fixAll.ruff": true
      },
      "format_on_save": "on",
      "language_servers": ["basedpyright", "ruff"],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    },
    "TypeScript": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "TSX": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "JavaScript": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "HTML": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "CSS": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "Rust": {
      "formatter": "language_server",
      "format_on_save": "on",
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true
      }
    }
  },
  "prettier": {
    "allowed": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "JetBrains",
  "ui_font_family": "D2Coding",
  "ui_font_size": 17,
  "buffer_font_family": "D2Coding",
  "buffer_font_size": 17,
  "show_whitespaces": "boundary",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Latte"
  },
  "icon_theme": "Catppuccin Latte",
  "terminal": {
    "font_family": "D2Coding"
  }
}
